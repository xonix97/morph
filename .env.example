# Morph does not require secrets for its local demos or core tests.
# Copy this file to .env only when a direct Python controlled-runtime process
# needs explicit local paths. The Rust launcher supplies these values itself.
# Never commit real credentials to this repository.

MORPH_SESSION=local
MORPH_PYTHON_CONTROL=.morph/python/reload.request
MORPH_PYTHON_STATUS=.morph/python/reload.status
